# Banco de dados: Neon Postgres (mesmo em dev e produção).
# Gere estes dois valores com `neon login && neon env pull` (veja o README).
# DATABASE_URL          -> conexão pooled, usada pelo app em runtime.
# DATABASE_URL_UNPOOLED -> conexão direta, usada só para migrações do Prisma.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Senha única do administrador (login em /admin/login). Troque antes de ir ao ar.
ADMIN_PASSWORD="troque-esta-senha"

# Segredo usado para assinar o cookie de sessão do admin. Gere um valor aleatório
# com pelo menos 32 caracteres, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-este-segredo-por-um-valor-aleatorio-de-32-ou-mais-caracteres"

# Cloudinary (armazenamento das fotos enviadas). Crie uma conta gratuita em
# https://cloudinary.com e pegue estes três valores no painel (Dashboard).
# Se ficarem em branco, em desenvolvimento local as fotos são salvas em
# /public/uploads como alternativa (não funciona em produção na Vercel).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
